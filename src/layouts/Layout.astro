---
import { withBase } from "../utils/paths";
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Creative Agency :: Melbourne Advertising - OMG! Creative",
  description = "OMG! Creative is a leading independent creative agency in Melbourne. We are on a mission to give brands a unique voice that resonates.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/observers.js";
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
