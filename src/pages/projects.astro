---
import ProjectListLayout from "../layouts/ProjectListLayout.astro";
import Header from "../components/Header.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import ProjectThumbnail from "../components/ProjectThumbnail.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = allProjects.sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);

// Extract unique categories, brands, and tags for filtering
const categories = [...new Set(projects.map((p) => p.data.category))].sort();
const brands = [
  ...new Set(projects.map((p) => p.data.brand).filter(Boolean)),
].sort();
const tags = [...new Set(projects.flatMap((p) => p.data.tags || []))].sort();
---

<ProjectListLayout
  title="Our Projects :: Creative Agency Melbourne - OMG! Creative"
  description="Explore our latest work and creative projects. From brand transformations to digital campaigns, see how we help brands find their unique voice."
>
  <Header variant="dark" />

  <main>
    <section class="projects-hero section">
      <div class="container container--narrow animate-on-scroll">
        <h1 class="hero__title">Our Work</h1>
        <p class="hero__lead">
          We partner with brands to create deliberately different experiences
          that drive real results.
        </p>
      </div>
    </section>

    <div class="filter-container" id="filter-container">
      <div class="container filter-container__inner">
        <div class="filter-groups-wrapper" id="filter-groups">
          <div class="filter-group">
            <span class="filter-label">Categories:</span>
            <div class="filter-wrapper">
              <button
                class="filter-btn active"
                data-filter-type="category"
                data-filter="all">All</button
              >
              {
                categories.map((category) => (
                  <button
                    class="filter-btn"
                    data-filter-type="category"
                    data-filter={category}
                  >
                    {category}
                  </button>
                ))
              }
            </div>
          </div>

          {
            brands.length > 0 && (
              <div class="filter-group">
                <span class="filter-label">Brands:</span>
                <div class="filter-wrapper">
                  <button
                    class="filter-btn active"
                    data-filter-type="brand"
                    data-filter="all"
                  >
                    All Cases
                  </button>
                  {brands.map((brand) => (
                    <button
                      class="filter-btn"
                      data-filter-type="brand"
                      data-filter={brand}
                    >
                      {brand}
                    </button>
                  ))}
                </div>
              </div>
            )
          }

          {
            tags.length > 0 && (
              <div class="filter-group">
                <span class="filter-label">Tags:</span>
                <div class="filter-wrapper">
                  <button
                    class="filter-btn active"
                    data-filter-type="tag"
                    data-filter="all"
                  >
                    All Tags
                  </button>
                  {tags.map((tag) => (
                    <button
                      class="filter-btn"
                      data-filter-type="tag"
                      data-filter={tag}
                    >
                      {tag}
                    </button>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <label class="filter-switch" id="filter-switch">
          <span class="filter-switch__text">Filters</span>
          <div class="filter-switch__control">
            <input
              type="checkbox"
              id="filter-toggle"
              checked
              aria-label="Toggle Filters"
            />
            <span class="filter-switch__slider"></span>
          </div>
        </label>
      </div>
    </div>

    <section class="projects-section">
      <div class="projects-grid" id="projects-grid">
        {
          projects.map((project) => (
            <ProjectThumbnail
              category={project.data.category}
              title={project.data.title}
              link={`/project/${project.id}`}
              posterUrl={project.data.posterUrl}
              videoUrl={project.data.videoUrl}
              logoSrc={project.data.logoSrc}
              data-brand={project.data.brand}
              data-tags={JSON.stringify(project.data.tags || [])}
            />
          ))
        }
      </div>
    </section>

    <ContactSection />
  </main>

  <Footer />
</ProjectListLayout>

<script>
  import "../scripts/filters.js";
</script>

<style>
  .projects-hero {
    padding-top: 180px;
    padding-bottom: 60px;
    background-color: var(--mono);
    color: var(--white);
    text-align: center;
  }

  .container--narrow {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero__title {
    font-size: clamp(48px, 8vw, 84px);
    margin-bottom: 20px;
  }

  .hero__lead {
    font-size: 20px;
    opacity: 0.8;
  }

  .filter-group {
    /* margin-bottom: 20px; */
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .filter-group:last-child {
    margin-bottom: 0;
  }

  .filter-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--mono);
    min-width: 100px;
    margin-top: 5px;
  }

  .filter-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }

  .projects-section {
    background: var(--white);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  @media (max-width: 992px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .filter-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .filter-label {
      min-width: unset;
    }
  }
</style>
