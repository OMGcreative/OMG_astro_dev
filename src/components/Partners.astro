---
import { withBase } from "../utils/paths";
// Partners section with logo grid
const partners = [
  { name: 'Royal Melbourne Show', logo: '/partners/royal-melbourne-show.svg', url: 'https://www.royalmelbourneshow.com.au/' },
  { name: 'A.G. Coombs', logo: '/partners/ag-coombs.svg', url: 'https://www.agcoombs.com.au/' },
  { name: 'Monash University', logo: '/partners/monash.svg', url: 'https://www.monash.edu/' },
  { name: 'Praemium', logo: '/partners/praemium.svg', url: 'https://www.praemium.com/' },
  { name: 'University of Melbourne', logo: '/partners/unimelb.svg', url: 'https://www.unimelb.edu.au/' },
  { name: 'Seven', logo: '/partners/seven.svg', url: 'https://www.seven.com.au/' },
  { name: 'Epworth', logo: '/partners/epworth.svg', url: 'https://www.epworth.org.au/' },
  { name: 'Ticketmaster', logo: '/partners/ticketmaster.svg', url: 'https://www.ticketmaster.com.au/' },
  { name: 'Lug+Carrie', logo: '/partners/lugcarrie.svg', url: 'https://lugandcarrie.com.au/' },
  { name: 'DiDi', logo: '/partners/didi.svg', url: 'https://www.didiglobal.com/' },
  { name: 'Remco', logo: '/partners/remco.svg', url: 'https://www.remco.com.au/' },
  { name: 'Samsung', logo: '/partners/samsung.svg', url: 'https://www.samsung.com/au/' },
];
---

<section class="partners-section">
  <div class="container">
    <h2 class="partners-title">Partners</h2>
    
    <div class="partners-grid">
      {partners.map((partner) => (
        <a href={partner.url} target="_blank" rel="noopener noreferrer" class="partner-logo" title={partner.name}>
          <img src={withBase(partner.logo)} alt={partner.name} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .partners-section {
    background-color: var(--black);
    padding: 100px 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .partners-title {
    color: var(--white);
    text-align: center;
    margin-bottom: 60px;
    font-size: var(--h2-size);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5vh;
    align-items: center;
    justify-items: center;
  }

  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 180px;
    height: 80px;
    opacity: 0.9;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .partner-logo:hover {
    opacity: 1;
    transform: scale(1.05);
  }

  .partner-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  @media (max-width: 992px) {
    .partners-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px 40px;
    }
  }

  @media (max-width: 768px) {
    .partners-section {
      padding: 60px 0;
    }

    .partners-title {
      margin-bottom: 40px;
    }

    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 30px;
    }

    .partner-logo {
      max-width: 140px;
      height: 60px;
    }
  }

  @media (max-width: 480px) {
    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .partner-logo {
      max-width: 120px;
      height: 50px;
    }
  }
</style>
