---
import { withBase } from "../utils/paths";
// Hero section with "Deliberately different" heading and image column
---

<section class="hero section section--light">
  <div class="hero__content">
    <div class="hero__text animate-on-scroll">
      <h1 class="hero__title">
        Deliberately<br />different
      </h1>
    </div>

    <div class="hero__media">
      <div class="hero__video-container">
        <!-- Placeholder video - replace with actual Vimeo/hosted video URL -->
        <video
          class="hero__video"
          width="400"
          height="600"
          muted
          loop="false"
          playsinline
          data-autoplay
          poster={withBase("assets/imgs/OMGCreative.jpg")}
          preload="auto"
        >
          <source
            src="https://player.vimeo.com/progressive_redirect/download/1066778899/rendition/source/00_omg_splash.mp4?loc=external&signature=c7de4a45645afd18e5a6f742dd9e7ad995eef19ba528326eed69c04ba90de84c"
            type="video/mp4"
          />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>

    <div class="hero__tagline animate-on-scroll">
      <p>
        We are a creative agency on a mission to give brands a unique voice that
        resonates.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0;
    background: var(--white);
  }

  .hero__content {
    width: 100%;
    max-width: var(--hero-max-width);
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 3dvw;
    align-items: center;
  }

  .hero__text {
    justify-self: start;
  }

  .hero__title {
    /* font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em; */
    text-align: right;
    font-size: 4.01vw;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.91;
  }

  .hero__media {
    display: flex;
    justify-content: center;
  }

  .hero__video-container {
    /* width: 400px; */
    height: 80vh;
    /* border-radius: 120px; */
    overflow: hidden;
    /* transform: rotate(5deg); */
    transition: transform var(--transition-slow);
  }

  .hero__video-container:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .hero__video {
    width: 100%;
    height: 100%;
    /* object-fit: cover; */
  }

  .hero__tagline {
    justify-self: start;
    /* max-width: 280px; */
    text-align: left;
  }

  .hero__tagline p {
    /* font-size: var(--body-size);
    line-height: 1.6; */
    font-size: 1.77vw;
    font-weight: 400;
    letter-spacing: -0.046em;
    line-height: 1.325;
    color: var(--53555A);
    margin-bottom: 0;
  }

  @media (max-width: 992px) {
    .hero__content {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    .hero__text,
    .hero__tagline {
      justify-self: center;
      text-align: center;
    }

    .hero__tagline {
      max-width: 400px;
    }

    .hero__video-container {
      width: 300px;
      height: 450px;
      transform: rotate(0);
    }
  }

  @media (max-width: 576px) {
    .hero {
      padding: 100px 0 60px;
    }

    .hero__video-container {
      width: 240px;
      height: 360px;
    }
  }
</style>
