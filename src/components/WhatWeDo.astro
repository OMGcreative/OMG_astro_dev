---
// "What We Do" section with video background
---

<section class="what-we-do section section--dark">
  <video
    class="video-background"
    data-autoplay
    muted
    loop="false"
    playsinline
    poster="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1920&h=1080&fit=crop"
  >
    <!-- Video source will be Vimeo URL when available -->
    <source src="" type="video/mp4" />
  </video>
  <div class="video-overlay"></div>

  <div class="section-content container">
    <div class="what-we-do__header">
      <span class="section-number">00.</span>
      <span class="section-label">WHAT WE DO</span>
    </div>

    <div class="what-we-do__content animate-on-scroll">
      <h2 class="what-we-do__title">
        Whether you're a giant in your field or just finding your way,
        <span class="text-accent"
          >there's a long list of stuff we can do to get your business on track
          for success.</span
        >
      </h2>

      <a href="/what-we-do/" class="learn-more">Learn More</a>
    </div>
  </div>

  <div class="scroll-indicator">
    <span>↓</span>
  </div>
</section>

<style>
  .what-we-do {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--section-padding) 0;
  }

  .what-we-do__header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 60px;
  }

  .section-number {
    font-size: var(--small-size);
    font-weight: 500;
    opacity: 0.7;
  }

  .section-label {
    font-size: var(--small-size);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-number::after {
    content: "";
    display: inline-block;
    width: 40px;
    height: 1px;
    background-color: currentColor;
    margin-left: 15px;
    vertical-align: middle;
    opacity: 0.5;
  }

  .what-we-do__content {
    max-width: 800px;
  }

  .what-we-do__title {
    font-size: clamp(24px, 4vw, 42px);
    /* font-weight: 500; */
    /* line-height: 1.3; */
    margin-bottom: 40px;
    color: var(--white);
  }

  .text-accent {
    /* opacity: 0.6; */
    color: var(--grey);
  }

  .learn-more {
    color: var(--white);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    right: 40px;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: bounce 2s infinite;
  }

  .scroll-indicator span {
    color: var(--white);
    font-size: 18px;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }

  @media (max-width: 768px) {
    .what-we-do__header {
      margin-bottom: 40px;
    }

    .scroll-indicator {
      right: 20px;
      bottom: 20px;
    }
  }
</style>
