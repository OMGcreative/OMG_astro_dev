---
import { withBase } from "../utils/paths";
interface Props {
  number?: string;
  category: string;
  title: string;
  logoSrc?: string;
  videoUrl?: string;
  posterUrl?: string;
}

const {
  number,
  category,
  title,
  logoSrc,
  videoUrl,
  posterUrl = "/assets/imgs/placeholder.png",
} = Astro.props;
---

<section class="project-hero section section--dark">
  {
    videoUrl ? (
      <video
        class="video-background"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={withBase(posterUrl)}
      >
        <source src={withBase(videoUrl)} type="video/mp4" />
      </video>
    ) : (
      <img class="video-background" src={withBase(posterUrl)} alt={title} />
    )
  }
  <div class="video-overlay"></div>

  <div class="container project-hero__container">
    <div class="project-hero__header animate-on-scroll">
      {number && <span class="section-number">{number}.</span>}
      <span class="section-label">{category}</span>
    </div>

    <div
      class="project-hero__content animate-on-scroll"
      style="transition-delay: 100ms;"
    >
      {
        logoSrc && (
          <img src={withBase(logoSrc)} alt={`${title} logo`} class="project-hero__logo" />
        )
      }
      <h1 class="project-hero__title">
        {title}
      </h1>
    </div>
  </div>
</section>

<style>
  .project-hero {
    position: relative;
    height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .project-hero__container {
    position: relative;
    z-index: 2;
  }

  .project-hero__header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
    color: var(--white);
  }

  .section-number {
    font-size: var(--small-size);
    font-weight: 500;
    opacity: 0.7;
    color: var(--white);
  }

  .section-label {
    font-size: var(--small-size);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
  }

  .section-number::after {
    content: "";
    display: inline-block;
    width: 40px;
    height: 1px;
    background-color: currentColor;
    margin-left: 15px;
    vertical-align: middle;
    opacity: 0.5;
  }

  .project-hero__content {
    max-width: 800px;
  }

  .project-hero__logo {
    height: 40px;
    width: auto;
    margin-bottom: 20px;
    filter: brightness(0) invert(1);
    display: block;
  }

  .project-hero__title {
    font-size: clamp(48px, 8vw, 120px);
    /* line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 700; */
    margin: 0;
    /* color: var(--white); */
    /* font-size: 6vw; */
    text-align: left;
    font-weight: 400;
    line-height: 80%;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    color: var(--white);
    max-width: 66%;
  }

  @media (max-width: 768px) {
    .project-hero {
      padding-top: 60px;
    }
  }
</style>
