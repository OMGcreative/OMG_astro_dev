---
import { withBase } from "../utils/paths";
interface Props {
  number: string;
  category: string;
  title: string;
  description: string;
  link: string;
  videoUrl?: string;
  posterUrl?: string;
  logoSrc?: string;
}

const {
  number,
  category,
  title,
  description,
  link,
  videoUrl,
  posterUrl = "/assets/imgs/placeholder.png",
  logoSrc,
} = Astro.props;
---

<section class="project-card section section--dark">
  {
    videoUrl ? (
      <video
        class="video-background"
        data-autoplay
        muted
        loop="false"
        playsinline
        preload="auto"
        poster={withBase(posterUrl)}
      >
        <source src={withBase(videoUrl)} type="video/mp4" />
      </video>
    ) : (
      <img
        class="video-background"
        src={withBase(posterUrl)}
        alt={title}
        loading="lazy"
      />
    )
  }
  <div class="video-overlay"></div>

  <div class="section-content container">
    <div class="project-card__header">
      <span class="section-number">{number}.</span>
      <span class="section-label">{category}</span>
    </div>

    <div class="project-card__content animate-on-scroll">
      {
        logoSrc && (
          <img src={withBase(logoSrc)} alt={`${title} logo`} class="project-card__logo" />
        )
      }

      <h2 class="project-card__title">
        <a href={withBase(link)}>{title}</a>
      </h2>

      <p class="project-card__description">{description}</p>

      <a href={withBase(link)} class="learn-more">Learn More</a>
    </div>
  </div>
</section>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--section-padding) 0;
  }

  .project-card__header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
  }

  .section-number {
    font-size: var(--small-size);
    font-weight: 500;
    opacity: 0.7;
    color: var(--white);
  }

  .section-label {
    font-size: var(--small-size);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
  }

  .section-number::after {
    content: "";
    display: inline-block;
    width: 40px;
    height: 1px;
    background-color: currentColor;
    margin-left: 15px;
    vertical-align: middle;
    opacity: 0.5;
  }

  .project-card__content {
    max-width: 600px;
  }

  .project-card__logo {
    height: 40px;
    width: auto;
    margin-bottom: 20px;
    filter: brightness(0) invert(1);
  }

  .project-card__content .project-card__logo + .project-card__title {
    display: none;
    visibility: hidden;
  }

  .project-card__title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    margin-bottom: 20px;
  }

  .project-card__title a {
    color: var(--white);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .project-card__title a:hover {
    opacity: 0.8;
  }

  .project-card__description {
    font-size: var(--body-size);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 30px;
    max-width: 500px;
  }

  .learn-more {
    color: var(--white);
  }

  @media (max-width: 768px) {
    .project-card__header {
      margin-bottom: 30px;
    }

    .project-card__logo {
      height: 30px;
    }
  }
</style>
